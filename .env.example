# Claude Lens configuration. Copy to .env.local and fill in real values.
# Never commit .env.local.

# Postgres connection string (postgresql://user:password@host:5432/dbname)
DATABASE_URL=
# All Claude Lens tables live in this schema
DB_SCHEMA=claude_dashboard
# Optional: Postgres for the backend test suite (default: DATABASE_URL). Tests only
# ever create and drop throwaway claude_lens_test_<random> schemas.
TEST_DATABASE_URL=

# Single admin account, created on first boot
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Set to false only for local http:// development
COOKIE_SECURE=true

# Where the Next.js frontend proxies /api/* requests
BACKEND_URL=http://localhost:8000

# Collector: transcript folder (default: ~/.claude/projects)
CLAUDE_PROJECTS_DIR=
# Collector: machine label stored with synced rows (default: hostname)
CLAUDE_LENS_MACHINE=
# Collector: rotating log for `claude-lens scan` (default: ~/.claude/claude-lens-sync.log)
CLAUDE_LENS_SYNC_LOG=
